{
  "name": "err-analyst",
  "displayName": "ErrAnalyst - 错误智能分析",
  "description": "智能分析 Python 报错，定位代码位置，AI 翻译错误信息并提供一键修复",
  "version": "0.1.1",
  "publisher": "errAnalyst",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/X-futur/errAnalyst.git"
  },
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "error",
    "analysis",
    "python",
    "traceback",
    "ai",
    "deepseek",
    "kimi",
    "qwen"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/src/extension.js",
  "bin": {
    "erranalyst": "./bin/erranalyst"
  },
  "contributes": {
    "commands": [
      {
        "command": "errAnalyst.focusPanel",
        "title": "erranalyst focuspanel show"
      },
      {
        "command": "errAnalyst.analyzeLastError",
        "title": "erranalyst analyst lasterr"
      },
      {
        "command": "errAnalyst.clearCache",
        "title": "erranalyst cache clear"
      },
      {
        "command": "errAnalyst.cacheShow",
        "title": "erranalyst cache show"
      },
      {
        "command": "errAnalyst.setProvider",
        "title": "erranalyst provider set"
      },
      {
        "command": "errAnalyst.setActiveProvider",
        "title": "erranalyst provider switch"
      },
      {
        "command": "errAnalyst.showConfig",
        "title": "erranalyst config show"
      },
      {
        "command": "errAnalyst.setModel",
        "title": "erranalyst model set"
      },
      {
        "command": "errAnalyst.memoryConfig",
        "title": "erranalyst memory config"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "errAnalyst-sidebar",
          "title": "ErrAnalyst",
          "icon": "$(error)"
        }
      ]
    },
    "views": {
      "errAnalyst-sidebar": [
        {
          "type": "webview",
          "id": "errAnalyst.errorHistory",
          "name": "错误分析"
        }
      ]
    },
    "configuration": {
      "title": "ErrAnalyst",
      "properties": {
        "errAnalyst.providers": {
          "type": "array",
          "default": [
            {
              "name": "DeepSeek",
              "baseUrl": "https://api.deepseek.com",
              "model": "deepseek-v4-flash",
              "apiKey": "",
              "enabled": true
            },
            {
              "name": "Kimi (Moonshot)",
              "baseUrl": "https://api.moonshot.cn/v1",
              "model": "kimi-k2.7-code-highspeed",
              "apiKey": "",
              "enabled": false
            },
            {
              "name": "Qwen (通义千问)",
              "baseUrl": "https://dashscope.aliyuncs.com/compatible-mode/v1",
              "model": "qwen3.7-flash",
              "apiKey": "",
              "enabled": false
            }
          ],
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "baseUrl": {
                "type": "string"
              },
              "model": {
                "type": "string"
              },
              "modelStatus": {
                "type": "string",
                "enum": [
                  "official",
                  "unofficial",
                  "unverified"
                ],
                "description": "自定义提供商的模型来源状态（预置提供商无需设置）"
              },
              "apiKey": {
                "type": "string"
              },
              "enabled": {
                "type": "boolean"
              }
            }
          },
          "description": "AI 模型提供商配置列表"
        },
        "errAnalyst.activeProvider": {
          "type": "string",
          "default": "DeepSeek",
          "description": "当前使用的 AI 提供商名称"
        },
        "errAnalyst.enableCache": {
          "type": "boolean",
          "default": true,
          "description": "保存错误历史（仅作历史查阅，不参与自动分析）"
        },
        "errAnalyst.aiTimeout": {
          "type": "number",
          "default": 15000,
          "description": "AI 请求超时时间（毫秒）"
        },
        "errAnalyst.enableOneClickFix": {
          "type": "boolean",
          "default": true,
          "description": "启用修复建议卡片的一键修复功能"
        },
        "errAnalyst.enableChat": {
          "type": "boolean",
          "default": true,
          "description": "启用修复建议卡片下方的错误分析对话功能"
        },
        "errAnalyst.memory.enabled": {
          "type": "boolean",
          "default": true,
          "description": "启用用户长期记忆（偏好与常犯错误统计参与分析、修复建议与对话提示词）"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "sync:commands": "node scripts/sync-commands.js",
    "compile": "npm run sync:commands && node scripts/copy-models.js && tsc -p ./",
    "watch": "npm run sync:commands && tsc -watch -p ./",
    "test": "node ./out/test/runTest.js",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.0",
    "@types/node": "^20.19.43",
    "@types/prismjs": "^1.26.6",
    "@types/vscode": "~1.96.0",
    "@vscode/test-electron": "^3.0.0",
    "@vscode/vsce": "^3.9.2",
    "eslint": "^8.50.0",
    "glob": "^10.0.0",
    "mocha": "^10.0.0",
    "typescript": "^5.3.0"
  },
  "enabledApiProposals": [
    "terminalDataWriteEvent"
  ],
  "dependencies": {
    "prismjs": "^1.30.0"
  }
}
