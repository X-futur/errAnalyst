{
  "name": "err-analyst",
  "displayName": "ErrAnalyst - \u9519\u8bef\u667a\u80fd\u5206\u6790",
  "description": "\u667a\u80fd\u5206\u6790 Python \u62a5\u9519\uff0c\u5b9a\u4f4d\u4ee3\u7801\u4f4d\u7f6e\uff0cAI \u7ffb\u8bd1\u9519\u8bef\u4fe1\u606f\u5e76\u63d0\u4f9b\u4e00\u952e\u4fee\u590d",
  "version": "0.1.0",
  "publisher": "errAnalyst",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "error",
    "analysis",
    "python",
    "traceback",
    "ai",
    "deepseek",
    "kimi",
    "qwen"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/src/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "errAnalyst.focusPanel",
        "title": "ErrAnalyst: \u67e5\u770b\u9519\u8bef\u5206\u6790\u9762\u677f"
      },
      {
        "command": "errAnalyst.analyzeLastError",
        "title": "ErrAnalyst: \u5206\u6790\u4e0a\u4e00\u4e2a\u62a5\u9519"
      },
      {
        "command": "errAnalyst.clearCache",
        "title": "ErrAnalyst: \u6e05\u9664\u9519\u8bef\u5206\u6790\u7f13\u5b58"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "errAnalyst-sidebar",
          "title": "ErrAnalyst",
          "icon": "$(error)"
        }
      ]
    },
    "views": {
      "errAnalyst-sidebar": [
        {
          "type": "webview",
          "id": "errAnalyst.errorHistory",
          "name": "\u9519\u8bef\u5386\u53f2"
        }
      ]
    },
    "configuration": {
      "title": "ErrAnalyst",
      "properties": {
        "errAnalyst.providers": {
          "type": "array",
          "default": [
            {
              "name": "DeepSeek",
              "baseUrl": "https://api.deepseek.com/v1",
              "model": "deepseek-v4-pro",
              "apiKey": "",
              "enabled": true
            },
            {
              "name": "Kimi (Moonshot)",
              "baseUrl": "https://api.moonshot.cn/v1",
              "model": "moonshot-v1-8k",
              "apiKey": "",
              "enabled": false
            },
            {
              "name": "Qwen (\u901a\u4e49\u5343\u95ee)",
              "baseUrl": "https://dashscope.aliyuncs.com/compatible-mode/v1",
              "model": "qwen-turbo",
              "apiKey": "",
              "enabled": false
            }
          ],
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "baseUrl": {
                "type": "string"
              },
              "model": {
                "type": "string"
              },
              "apiKey": {
                "type": "string"
              },
              "enabled": {
                "type": "boolean"
              }
            }
          },
          "description": "AI \u6a21\u578b\u63d0\u4f9b\u5546\u914d\u7f6e\u5217\u8868"
        },
        "errAnalyst.activeProvider": {
          "type": "string",
          "default": "DeepSeek",
          "description": "\u5f53\u524d\u4f7f\u7528\u7684 AI \u63d0\u4f9b\u5546\u540d\u79f0"
        },
        "errAnalyst.autoAnalyze": {
          "type": "boolean",
          "default": true,
          "description": "\u7ec8\u7aef\u68c0\u6d4b\u5230\u62a5\u9519\u65f6\u81ea\u52a8\u8c03\u7528 AI \u5206\u6790"
        },
        "errAnalyst.enableCache": {
          "type": "boolean",
          "default": true,
          "description": "\u542f\u7528\u9519\u8bef\u7f13\u5b58"
        },
        "errAnalyst.aiTimeout": {
          "type": "number",
          "default": 15000,
          "description": "AI \u8bf7\u6c42\u8d85\u65f6\u65f6\u95f4\uff08\u6beb\u79d2\uff09"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.0",
    "@types/node": "^20.19.43",
    "@types/vscode": "^1.96.0",
    "@vscode/test-electron": "^3.0.0",
    "eslint": "^8.50.0",
    "glob": "^10.0.0",
    "mocha": "^10.0.0",
    "typescript": "^5.3.0"
  }
}
