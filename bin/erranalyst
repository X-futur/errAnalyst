#!/usr/bin/env node

const path = require('path');
const fs = require('fs');
const os = require('os');
const { execSync } = require('child_process');

// ── Paths ──
const VSCODE_SETTINGS = path.join(os.homedir(), 'Library/Application Support/Code/User/settings.json');
const CURSOR_SETTINGS = path.join(os.homedir(), 'Library/Application Support/Cursor/User/settings.json');
const KEYCHAIN_SERVICE = 'erranalyst';
const HOME = os.homedir();
const ERR_DIR = path.join(HOME, '.errAnalyst');
const CREDENTIALS_FILE = path.join(ERR_DIR, "credentials.json");
const API_KEY_PREFIX = 'errAnalyst:apiKey:';
const errStore = require('../src/shared/err-store');
const memoryStore = require('../src/shared/memory-store');
const modelCatalog = require('../src/shared/model-catalog');
const modelValidation = require('../src/shared/model-validation');
const COMMANDS = JSON.parse(fs.readFileSync(path.join(__dirname, '..', 'commands.json'), 'utf-8'));


function findSettingsFile() {
  for (const p of [VSCODE_SETTINGS, CURSOR_SETTINGS]) {
    if (fs.existsSync(p)) return p;
  }
  return VSCODE_SETTINGS;
}

function readSettings() {
  const p = findSettingsFile();
  if (!fs.existsSync(p)) {
    console.error(`Error: settings.json not found at ${p}`);
    process.exit(1);
  }
  return JSON.parse(fs.readFileSync(p, 'utf-8'));
}

function writeSettings(data) {
  const p = findSettingsFile();
  fs.mkdirSync(path.dirname(p), { recursive: true });
  fs.writeFileSync(p, JSON.stringify(data, null, 2) + '\n', 'utf-8');
}

// ── Keychain helpers (macOS `security` command) ──

function keychainGet(account) {
  try {
    return execSync(
      `security find-generic-password -a "${account}" -s "${KEYCHAIN_SERVICE}" -w 2>/dev/null`,
      { timeout: 3000 }
    ).toString().trim() || null;
  } catch { return null; }
}

function keychainSet(account, password) {
  try {
    execSync(`security delete-generic-password -a "${account}" -s "${KEYCHAIN_SERVICE}" 2>/dev/null`, { timeout: 3000 });
  } catch { }
  execSync(
    `security add-generic-password -a "${account}" -s "${KEYCHAIN_SERVICE}" -w "${password}" -U 2>/dev/null`,
    { timeout: 3000 }
  );
}

function keychainDelete(account) {
  try {
    execSync(`security delete-generic-password -a "${account}" -s "${KEYCHAIN_SERVICE}" 2>/dev/null`, { timeout: 3000 });
  } catch { }
}

// ── Preset providers（单一来源：官方模型快照） ──

const PRESETS = {};
for (const p of modelCatalog.getPresetProviders()) {
  PRESETS[p.name] = { baseUrl: p.baseUrl, model: modelCatalog.getRecommendedModel(p.name) };
}

// ── Helpers ──

function maskKey(key) {
  if (!key) return '(not set)';
  if (key.length <= 8) return key.slice(0, 2) + '****';
  return key.slice(0, 4) + '****' + key.slice(-4);
}

// ── Read API key: credentials file first, then keychain ──
function getApiKey(providerOrKey) {
  const providerName = String(providerOrKey).startsWith(API_KEY_PREFIX)
    ? String(providerOrKey).slice(API_KEY_PREFIX.length)
    : String(providerOrKey);

  if (fs.existsSync(CREDENTIALS_FILE)) {
    try {
      const creds = JSON.parse(fs.readFileSync(CREDENTIALS_FILE, "utf-8"));
      if (creds[providerName]) return creds[providerName];
    } catch { }
  }
  return keychainGet(API_KEY_PREFIX + providerName);
}

// ── 模型选择与校验（官方模型列表） ──

/** 预置提供商模型编号菜单：推荐模型置顶，无自由输入。返回模型 id，null 表示取消。 */
async function pickPresetModelMenu(providerName, currentModel, ask) {
  const models = modelCatalog.getActiveModels(providerName);
  if (models.length === 0) {
    console.log('No official models available for ' + providerName);
    return null;
  }
  const currentValid = models.some((m) => m.id === currentModel);
  const recommended = modelCatalog.getRecommendedModel(providerName);
  console.log(`\n${providerName} 官方模型列表（⚡ 推荐 · 速度优先）:`);
  models.forEach((m, i) => {
    const rec = m.recommended ? '⚡ 推荐 · ' : '';
    const cur = m.id === currentModel ? '  (当前)' : '';
    const tier = m.tier === 'fast' ? ' · 快速' : m.tier === 'balanced' ? ' · 均衡' : ' · 更强';
    console.log(`  ${i + 1}. ${rec}${m.id}${tier}${cur}`);
  });
  if (!currentValid && currentModel) {
    console.log(`  ⚠ 当前模型 "${currentModel}" 不在官方模型列表或已下线，必须重新选择。`);
  }
  const defaultHint = currentValid ? currentModel : recommended;
  const answer = (await ask(`选择序号（Enter 使用 ${defaultHint || '推荐模型'}）: `)).trim();
  if (!answer) {
    if (currentValid) return currentModel;
    if (recommended) return recommended;
    return null;
  }
  const idx = parseInt(answer, 10) - 1;
  if (isNaN(idx) || idx < 0 || idx >= models.length) {
    console.log('无效选择');
    return null;
  }
  return models[idx].id;
}

/** 自定义提供商模型校验：抓取 /models，失败回退连接测试；非官方模型需确认。返回状态或 null（取消/失败）。 */
async function validateCustomModelForCli(name, baseUrl, model, apiKey, ask) {
  if (!apiKey) {
    console.log(`无法校验 ${name} 的模型：缺少 API Key`);
    return null;
  }
  const result = await modelValidation.validateCustomModel(baseUrl, model, apiKey);
  if (!result.ok) {
    console.log(`模型校验失败：${result.error}`);
    return null;
  }
  if (result.status === 'unofficial') {
    const confirm = (await ask(`模型 "${model}" 不在 ${name} 的官方模型列表，仍要保存？将标记为非官方模型。 [y/N] `)).trim().toLowerCase();
    if (confirm !== 'y') {
      console.log('已取消');
      return null;
    }
  } else if (result.status === 'unverified') {
    console.log(`⚠ 无法获取 ${name} 的官方模型列表，已通过连接测试；模型将标记为"未通过官方列表校验"。`);
  } else {
    console.log(`✓ 模型 "${model}" 已通过官方模型列表校验。`);
  }
  return result.status;
}


// ── Commands ──

function cmdConfigShow() {
  const raw = readSettings();
  const providers = raw['errAnalyst.providers'] || [];
  const activeProvider = raw['errAnalyst.activeProvider'] || '(none)';
  const enableCache = raw['errAnalyst.enableCache'] !== false;
  const aiTimeout = raw['errAnalyst.aiTimeout'] || 15000;

  const output = {
    activeProvider,
    enableCache,
    aiTimeout,
    totalProviders: providers.length,
    providers: providers.map(p => ({
      name: p.name,
      baseUrl: p.baseUrl,
      model: p.model,
      apiKey: getApiKey(`errAnalyst:apiKey:${p.name}`) ? 'configured' : 'empty',
      enabled: p.enabled,
      isActive: p.name === activeProvider,
      modelStatus: (() => {
        if (Object.prototype.hasOwnProperty.call(PRESETS, p.name)) {
          const s = modelCatalog.getModelStatus(p.name, p.model);
          return s === 'valid'
            ? '官方模型'
            : s === 'deprecated'
              ? '已下线/即将下线'
              : '无效模型（不在官方列表）';
        }
        return p.modelStatus ? modelValidation.modelStatusLabel(p.modelStatus) : '未校验';
      })(),
    })),
  };

  console.log(JSON.stringify(output, null, 2));
}

async function cmdProviderSet() {
  const raw = readSettings();
  let providers = raw['errAnalyst.providers'] || [];

  // Collect available options
  const existingNames = providers.map(p => p.name);
  const options = [
    ...providers.map(p => ({ name: p.name, label: `${p.name} (current: ${p.model})`, isNew: false })),
    ...Object.keys(PRESETS).filter(n => !existingNames.includes(n)).map(n => ({ name: n, label: `${n} — ${PRESETS[n].baseUrl}`, isNew: true })),
    { name: '__custom__', label: 'Custom (enter manually)', isNew: true },
  ];

  // Quick pick using readline
  console.log('\nAvailable providers:');
  options.forEach((o, i) => console.log(`  ${i + 1}. ${o.label}`));
  process.stdout.write('\nSelect number: ');

  // Simple input
  const readline = require('readline').createInterface({ input: process.stdin, output: process.stdout });

  const ask = (q) => new Promise(r => readline.question(q, r));

  const selIdx = parseInt(await ask(''), 10) - 1;
  if (isNaN(selIdx) || selIdx < 0 || selIdx >= options.length) {
    console.log('Invalid selection'); readline.close(); return;
  }

  const selected = options[selIdx];
  let name = selected.name;
  let baseUrl = '';
  let model = '';

  if (name === '__custom__') {
    name = await ask('Provider name: ');
    if (!name) { console.log('Cancelled'); readline.close(); return; }
    baseUrl = await ask('Base URL: ');
    if (!baseUrl) { console.log('Cancelled'); readline.close(); return; }
    model = await ask('Model: ');
    if (!model) { console.log('Cancelled'); readline.close(); return; }
  } else {
    baseUrl = PRESETS[name]?.baseUrl || '';
    model = PRESETS[name]?.model || '';
    const existing = providers.find(p => p.name === name);
    if (existing) {
      baseUrl = existing.baseUrl;
      model = existing.model;
    }
  }

  // API key
  const existingKey = getApiKey(name);
  const keyPrompt = existingKey ? `API Key (leave empty to keep existing): ` : `API Key: `;
  const apiKey = (await ask(keyPrompt)).trim();
  const finalKey = apiKey || existingKey || '';
  if (!finalKey) { console.log('API Key is required'); readline.close(); return; }

  // Model 选择：预置提供商从官方列表选（推荐置顶，无自由输入）；自定义提供商手动输入 + 校验。
  let modelStatus;
  const isPreset = Object.prototype.hasOwnProperty.call(PRESETS, name);
  if (isPreset) {
    const picked = await pickPresetModelMenu(name, model, ask);
    if (picked === null) { readline.close(); return; }
    model = picked;
  } else if (selected.isNew) {
    const status = await validateCustomModelForCli(name, baseUrl, model, finalKey, ask);
    if (!status) { readline.close(); return; }
    modelStatus = status;
  } else {
    const m = (await ask(`Model (leave empty to keep "${model}"): `)).trim();
    if (m) {
      const status = await validateCustomModelForCli(name, baseUrl, m, finalKey, ask);
      if (!status) { readline.close(); return; }
      model = m;
      modelStatus = status;
    }
  }

  // Save to settings.json
  const entry = { name, baseUrl, model, apiKey: '', enabled: true, ...(modelStatus ? { modelStatus } : {}) };
  const idx = providers.findIndex(p => p.name === name);
  if (idx >= 0) providers[idx] = { ...providers[idx], ...entry };
  else providers.push(entry);

  raw['errAnalyst.providers'] = providers;
  raw['errAnalyst.activeProvider'] = name;
  writeSettings(raw);

  // Save API key to keychain
  keychainSet(API_KEY_PREFIX + name, finalKey);
  // Also write to credentials file for CLI config show
  try {
    const dir = require("path").dirname(CREDENTIALS_FILE);
    if (!require("fs").existsSync(dir)) require("fs").mkdirSync(dir, { recursive: true });
    let creds = {};
    if (require("fs").existsSync(CREDENTIALS_FILE)) {
      creds = JSON.parse(require("fs").readFileSync(CREDENTIALS_FILE, "utf-8"));
    }
    creds[name] = finalKey;
    require("fs").writeFileSync(CREDENTIALS_FILE, JSON.stringify(creds, null, 2));
  } catch { }

  console.log(`\n✓ Provider "${name}" configured (model: ${model})`);
  readline.close();
}

function cmdProviderSwitch() {
  const raw = readSettings();
  const providers = raw['errAnalyst.providers'] || [];
  if (providers.length === 0) {
    console.log('No providers configured. Use "erranalyst provider set" first.');
    return;
  }

  const current = raw['errAnalyst.activeProvider'] || '';
  console.log('\nConfigured providers:');
  providers.forEach((p, i) => console.log(`  ${i + 1}. ${p.name} ${p.name === current ? '(active)' : ''}`));
  process.stdout.write('\nSelect number: ');

  const readline = require('readline').createInterface({ input: process.stdin, output: process.stdout });
  readline.question('', (answer) => {
    const idx = parseInt(answer, 10) - 1;
    if (isNaN(idx) || idx < 0 || idx >= providers.length) {
      console.log('Invalid selection');
    } else {
      raw['errAnalyst.activeProvider'] = providers[idx].name;
      writeSettings(raw);
      console.log(`\n✓ Switched to provider: ${providers[idx].name}`);
    }
    readline.close();
  });
}

async function cmdModelSet() {
  const raw = readSettings();
  const providers = raw['errAnalyst.providers'] || [];
  if (providers.length === 0) {
    console.log('No providers configured.');
    return;
  }

  console.log('\nSelect provider:');
  providers.forEach((p, i) => console.log(`  ${i + 1}. ${p.name} (current: ${p.model})`));
  process.stdout.write('\nSelect number: ');

  const readline = require('readline').createInterface({ input: process.stdin, output: process.stdout });
  const ask = (q) => new Promise(r => readline.question(q, r));

  const idx = parseInt(await ask(''), 10) - 1;
  if (isNaN(idx) || idx < 0 || idx >= providers.length) {
    console.log('Invalid selection'); readline.close(); return;
  }

  const provider = providers[idx];
  const isPreset = Object.prototype.hasOwnProperty.call(PRESETS, provider.name);
  let model;
  let modelStatus;
  if (isPreset) {
    const picked = await pickPresetModelMenu(provider.name, provider.model, ask);
    if (picked === null) { readline.close(); return; }
    model = picked;
  } else {
    const input = (await ask(`New model for ${provider.name} (current: ${provider.model}): `)).trim();
    if (!input) { console.log('Cancelled'); readline.close(); return; }
    const apiKey = getApiKey(provider.name);
    const status = await validateCustomModelForCli(provider.name, provider.baseUrl, input, apiKey, ask);
    if (!status) { readline.close(); return; }
    model = input;
    modelStatus = status;
  }

  providers[idx].model = model;
  if (modelStatus) providers[idx].modelStatus = modelStatus;
  raw['errAnalyst.providers'] = providers;
  writeSettings(raw);
  console.log(`\n✓ Model updated: ${providers[idx].name} → ${model}${modelStatus ? `（${modelValidation.modelStatusLabel(modelStatus)}）` : ''}`);
  readline.close();
}

async function cmdCacheShow() {
  const entries = errStore.readCache();
  if (entries.length === 0) {
    console.log('Local analysis cache is empty.');
    return;
  }

  console.log('\nLocal analysis cache:');
  entries.forEach((e, i) => {
    const time = new Date(e.lastSeen).toLocaleString('zh-CN');
    console.log(`  ${i + 1}. ${e.errorType} - ${(e.errorMessage || '').slice(0, 80)} (${time} · ${e.count} times)`);
  });

  const readline = require('readline').createInterface({ input: process.stdin, output: process.stdout });
  const ask = (q) => new Promise(r => readline.question(q, r));
  const answer = (await ask('\nSelect a number to view full analysis (Enter to skip): ')).trim();
  readline.close();

  const idx = parseInt(answer, 10) - 1;
  if (isNaN(idx) || idx < 0 || idx >= entries.length) return;

  const e = entries[idx];
  console.log('\n' + '='.repeat(60));
  console.log(`Error: ${e.errorType}`);
  console.log(`Message: ${e.errorMessage}`);
  console.log(`First seen: ${new Date(e.firstSeen).toLocaleString('zh-CN')}`);
  console.log(`Last seen: ${new Date(e.lastSeen).toLocaleString('zh-CN')}`);
  console.log(`Count: ${e.count}`);
  console.log('\nTranslation:');
  console.log(e.translation || '(none)');
  console.log('\nAnalysis:');
  console.log(e.analysis || '(none)');
  console.log('\nFix suggestion:');
  console.log(e.fixSuggestion || '(none)');
  if (e.fullTraceback) {
    console.log('\nTraceback:');
    console.log(e.fullTraceback.slice(0, 3000));
  }
  console.log('='.repeat(60));
}

// ── Memory config ──

const MEMORY_CATEGORY_LABELS = {
  fix: '修复偏好',
  fixSuggestion: '修复建议偏好',
  analysis: '错误分析偏好',
};

function memoryRead() {
  const data = memoryStore.readMemory();
  if (data && data.format === 'memory-v1' && Array.isArray(data.preferences)) return data;
  return { format: 'memory-v1', preferences: [], errorStats: {} };
}

function memoryEnabled() {
  try {
    const raw = readSettings();
    return raw['errAnalyst.memory.enabled'] !== false;
  } catch {
    return true;
  }
}

function memoryList(data) {
  if (data.preferences.length === 0) {
    console.log('  当前没有记忆条目。');
    return;
  }
  data.preferences
    .slice()
    .sort((a, b) => (a.status === b.status ? b.lastUsedAt - a.lastUsedAt : a.status === 'active' ? -1 : 1))
    .forEach((p, i) => {
      const cat = MEMORY_CATEGORY_LABELS[p.category] || p.category;
      const src = p.source === 'implicit' ? '行为推断' : '用户声明';
      const status = p.status === 'candidate' ? ' [待确认]' : '';
      const conf = p.source === 'implicit' ? ` · 置信 ${Number(p.confidence || 0).toFixed(1)}` : '';
      console.log(`  ${i + 1}. ${cat} · ${src}${status} · ${p.statement}${conf}`);
    });
}

function memoryPickEntry(ask, data) {
  return new Promise((resolve) => {
    if (data.preferences.length === 0) {
      console.log('  当前没有可操作的条目。');
      resolve(null);
      return;
    }
    console.log('');
    data.preferences.forEach((p, i) => {
      const cat = MEMORY_CATEGORY_LABELS[p.category] || p.category;
      const status = p.status === 'candidate' ? ' [待确认]' : '';
      console.log(`  ${i + 1}. ${cat}${status} · ${p.statement}`);
    });
    ask('\n选择序号 (Enter 取消): ').then((answer) => {
      const idx = parseInt(answer, 10) - 1;
      if (isNaN(idx) || idx < 0 || idx >= data.preferences.length) resolve(null);
      else resolve(data.preferences[idx]);
    });
  });
}

async function cmdMemoryConfig() {
  const readline = require('readline').createInterface({ input: process.stdin, output: process.stdout });
  const ask = (q) => new Promise(r => readline.question(q, r));
  let data = memoryRead();

  while (true) {
    const enabled = memoryEnabled();
    const active = data.preferences.filter(p => p.status === 'active').length;
    const candidates = data.preferences.filter(p => p.status === 'candidate').length;
    console.log('\n══════════ ErrAnalyst 用户记忆 ══════════');
    console.log(`状态: ${enabled ? '已开启（参与分析/修复/对话提示词）' : '已关闭（不读取不注入）'}`);
    console.log(`偏好: ${active} 条生效 · ${candidates} 条待确认`);
    console.log(`常犯错误: ${Object.keys(data.errorStats).length} 类`);
    console.log('');
    console.log('1. 查看记忆条目');
    console.log('2. 新增偏好（显式声明）');
    console.log('3. 编辑或删除条目');
    console.log('4. 确认待确认候选');
    console.log(`5. ${enabled ? '关闭长期记忆' : '开启长期记忆'}`);
    console.log('6. 清空全部记忆');
    console.log('0. 退出');
    const choice = (await ask('\n选择: ')).trim();
    if (choice === '0' || choice === '') break;

    if (choice === '1') {
      memoryList(data);
    } else if (choice === '2') {
      console.log('\n类别:');
      Object.entries(MEMORY_CATEGORY_LABELS).forEach(([label], i) => {
        console.log(`  ${i + 1}. ${label}`);
      });
      const catIdx = parseInt(await ask('\n选择类别: '), 10) - 1;
      const categories = Object.keys(MEMORY_CATEGORY_LABELS);
      if (isNaN(catIdx) || catIdx < 0 || catIdx >= categories.length) {
        console.log('无效选择');
        continue;
      }
      const statement = (await ask('偏好内容（一句话）: ')).trim();
      if (!statement) { console.log('已取消'); continue; }
      data.preferences.push({
        id: `mem-${Date.now()}-${data.preferences.length}`,
        category: categories[catIdx],
        statement,
        source: 'explicit',
        status: 'active',
        confidence: 1,
        createdAt: Date.now(),
        lastUsedAt: Date.now(),
        hitCount: 0,
      });
      memoryStore.writeMemory(data);
      console.log(`✓ 已添加 ${MEMORY_CATEGORY_LABELS[categories[catIdx]]}（用户声明，立即生效）`);
    } else if (choice === '3') {
      const entry = await memoryPickEntry(ask, data);
      if (!entry) continue;
      console.log('\n操作:');
      console.log('  1. 编辑内容');
      console.log('  2. 修改类别');
      console.log('  3. 删除该条目');
      const op = (await ask('\n选择: ')).trim();
      if (op === '3') {
        data.preferences = data.preferences.filter(p => p.id !== entry.id);
        memoryStore.writeMemory(data);
        console.log('✓ 已删除条目');
      } else if (op === '1') {
        const text = (await ask(`新的内容 (当前: ${entry.statement}): `)).trim();
        if (!text) { console.log('已取消'); continue; }
        entry.statement = text;
        memoryStore.writeMemory(data);
        console.log('✓ 已更新内容');
      } else if (op === '2') {
        console.log('\n类别:');
        Object.entries(MEMORY_CATEGORY_LABELS).forEach(([key, label], i) => {
          console.log(`  ${i + 1}. ${label}${key === entry.category ? ' (当前)' : ''}`);
        });
        const catIdx = parseInt(await ask('\n选择新类别: '), 10) - 1;
        const categories = Object.keys(MEMORY_CATEGORY_LABELS);
        if (isNaN(catIdx) || catIdx < 0 || catIdx >= categories.length) {
          console.log('无效选择');
          continue;
        }
        entry.category = categories[catIdx];
        memoryStore.writeMemory(data);
        console.log('✓ 已更新类别');
      }
    } else if (choice === '4') {
      const candidates = data.preferences.filter(p => p.status === 'candidate');
      if (candidates.length === 0) {
        console.log('  当前没有待确认候选。');
        continue;
      }
      console.log('\n待确认候选:');
      candidates.forEach((p, i) => {
        console.log(`  ${i + 1}. ${MEMORY_CATEGORY_LABELS[p.category] || p.category} · ${p.statement}（观察 ${p.hitCount || 1} 次）`);
      });
      const idx = parseInt(await ask('\n选择要确认的候选 (Enter 取消): '), 10) - 1;
      if (isNaN(idx) || idx < 0 || idx >= candidates.length) continue;
      const entry = candidates[idx];
      entry.status = 'active';
      entry.confidence = Math.max(0.6, Number(entry.confidence) || 0);
      memoryStore.writeMemory(data);
      console.log('✓ 候选已确认，开始生效');
    } else if (choice === '5') {
      const raw = readSettings();
      raw['errAnalyst.memory.enabled'] = !enabled;
      writeSettings(raw);
      console.log(enabled ? '✓ 已关闭长期记忆' : '✓ 已开启长期记忆');
    } else if (choice === '6') {
      const confirm = (await ask('确定清空全部长期记忆？输入 yes 确认: ')).trim();
      if (confirm !== 'yes') { console.log('已取消'); continue; }
      data = { format: 'memory-v1', preferences: [], errorStats: {} };
      memoryStore.writeMemory(data);
      console.log('✓ 已清空全部长期记忆');
    }
  }
  readline.close();
}

function cmdHelp() {
  const cliCommands = COMMANDS
    .filter(c => c.cli)
    .sort((a, b) => a.cli.localeCompare(b.cli));
  const vscodeCommands = COMMANDS
    .filter(c => c.vscodeId)
    .sort((a, b) => a.title.localeCompare(b.title));

  const lines = [];
  lines.push('');
  lines.push('Usage: erranalyst <command> [args]');
  lines.push('');
  lines.push('CLI Commands:');
  for (const c of cliCommands) {
    lines.push('  ' + c.cli.padEnd(18) + c.description);
  }
  lines.push('');
  lines.push('VS Code Commands (run in Command Palette):');
  for (const c of vscodeCommands) {
    lines.push('  ' + c.title.padEnd(32) + c.description);
  }
  lines.push('');
  console.log(lines.join('\n'));
}

const CLI_HANDLERS = {
  'config show': cmdConfigShow,
  'cache show': cmdCacheShow,
  'provider set': cmdProviderSet,
  'provider switch': cmdProviderSwitch,
  'model set': cmdModelSet,
  'memory config': cmdMemoryConfig,
  'help': cmdHelp,
};

// ── Main ──

const args = process.argv.slice(2);

if (args.length === 0 || args.includes('--help') || args.includes('-h')) {
  cmdHelp();
  process.exit(0);
}

const command = args.join(' ');
const handler = CLI_HANDLERS[command];

if (handler) {
  const result = handler();
  if (result && typeof result.catch === 'function') {
    result.catch((e) => {
      console.error(e);
      process.exit(1);
    });
  }
} else {
  console.log('Unknown command: ' + command);
  cmdHelp();
}
